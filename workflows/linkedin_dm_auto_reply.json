{
  "name": "LinkedIn DM Auto-Reply (Unipile)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "unipile-linkedin-dm",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "d1a1b2c3-0001-4000-8000-000000000001",
      "name": "Webhook - Unipile Events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "unipile-linkedin-dm"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-event-type",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "message_received",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "condition-not-self",
              "leftValue": "={{ $json.body.sender.attendee_provider_id }}",
              "rightValue": "={{ $json.body.account_info.user_id }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "condition-linkedin",
              "leftValue": "={{ $json.body.account_type }}",
              "rightValue": "LINKEDIN",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "d1a1b2c3-0002-4000-8000-000000000002",
      "name": "Filter - Incoming Messages Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract relevant info from Unipile webhook payload\nconst body = $input.first().json.body;\n\nreturn [{\n  json: {\n    chat_id: body.chat_id,\n    account_id: body.account_id,\n    message_text: body.message || '',\n    sender_name: body.sender?.attendee_name || 'Unknown',\n    sender_id: body.sender?.attendee_provider_id || '',\n    sender_profile: body.sender?.attendee_profile_url || '',\n    timestamp: body.timestamp,\n    message_id: body.message_id\n  }\n}];"
      },
      "id": "d1a1b2c3-0003-4000-8000-000000000003",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "U5Z9K2eB2YxCiS2A"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        }
      },
      "id": "d1a1b2c3-0008-4000-8000-000000000008",
      "name": "Log to Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build OpenAI request body safely (proper JSON serialization, no raw interpolation)\nconst senderName = $input.first().json.sender_name || 'Unknown';\nconst messageText = $input.first().json.message_text || '';\n\nconst requestBody = {\n  model: 'gpt-4o-mini',\n  messages: [\n    {\n      role: 'system',\n      content: 'You are a professional LinkedIn messaging assistant replying on behalf of the account owner. Your responses should be: brief (1-3 sentences max), professional but friendly, natural sounding (not robotic), relevant to the message content. Do NOT include greetings like Dear or sign-offs like Best regards. Just write the message body as you would in a casual LinkedIn chat.'\n    },\n    {\n      role: 'user',\n      content: `Reply to this LinkedIn DM from ${senderName}:\\n\\n\"${messageText}\"\\n\\nWrite a brief, professional reply.`\n    }\n  ],\n  max_tokens: 150,\n  temperature: 0.7\n};\n\nreturn [{ json: { requestBody, ...($input.first().json) } }];"
      },
      "id": "d1a1b2c3-0004-4000-8000-000000000004",
      "name": "Build OpenAI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 560],
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_OPENAI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {}
      },
      "id": "d1a1b2c3-0004b-4000-8000-000000000007",
      "name": "OpenAI - Generate Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 560],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Extract the AI-generated reply from OpenAI response\nconst openaiResponse = $input.first().json;\nconst aiReply = openaiResponse.choices[0].message.content.trim();\n\n// Carry forward the chat_id from the previous extraction step\nconst extractedData = $('Extract Message Data').first().json;\n\nreturn [{\n  json: {\n    reply_text: aiReply,\n    chat_id: extractedData.chat_id,\n    account_id: extractedData.account_id,\n    original_message: extractedData.message_text,\n    sender_name: extractedData.sender_name\n  }\n}];"
      },
      "id": "d1a1b2c3-0005-4000-8000-000000000005",
      "name": "Format Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 560],
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api50.unipile.com:18099/api/v1/chats/{{ $json.chat_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "SFudJvgP.XCwN2ycbuARUPp6bKQNfrAj0ab4xGIhC83WI81PH4BU="
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.reply_text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "d1a1b2c3-0006-4000-8000-000000000006",
      "name": "Unipile - Send Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 560],
      "disabled": true
    }
  ],
