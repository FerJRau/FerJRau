        "jsonBody": "={{ JSON.stringify({ to: 'REEMPLAZAR_TELEFONO_OPERADOR', text: '🔧 *MANTENIMIENTO* — ' + $('Split Recordatorios').item.json._task_name + '\\nConfirma con *HECHO* al terminar. Si no confirmas, se escala al supervisor.' }) }}",
        "options": {}
