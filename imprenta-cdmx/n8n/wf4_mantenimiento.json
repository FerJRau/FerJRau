    {
      "parameters": {
        "operation": "getAll",
        "tableId": "maintenance_logs",
        "returnAll": true
      },
      "id": "b4000000-0000-4000-8000-000000000003",
      "name": "Get Logs",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "afViDlP7RXmh3xeK",
          "name": "IMPCDMX Supabase (imprenta-cdmx)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Decide qué recordatorios crear y qué escalar.\n// Soporta cron simplificado: 'min hora * * diasem' (ej. '0 7 * * *' diario 7am, '0 7 * * 1' lunes 7am)\nconst tasks = $('Get Tareas Activas').all().map(i => i.json).filter(t => t.id);\nconst logs = $input.all().map(i => i.json).filter(l => l.id);\nconst now = new Date();\n\nfunction cronMatchesThisHour(expr) {\n  const parts = String(expr || '').trim().split(/\\s+/);\n  if (parts.length < 5) return false;\n  const [, hour, , , dow] = parts;\n  const h = now.getUTCHours();\n  const d = now.getUTCDay();\n  const hourOk = hour === '*' || hour.split(',').some(x => parseInt(x, 10) === h);\n  const dowOk = dow === '*' || dow.split(',').some(x => parseInt(x, 10) === d);\n  return hourOk && dowOk;\n}\n\nconst reminders = [];\nconst escalations = [];\n\nfor (const t of tasks) {\n  const tLogs = logs.filter(l => l.task_id === t.id);\n\n  // 1. ¿Toca recordatorio esta hora y no existe log de hoy?\n  if (cronMatchesThisHour(t.cron_expression)) {\n    const today = now.toISOString().slice(0, 10);\n    const already = tLogs.some(l => (l.due_at || '').slice(0, 10) === today);\n    if (!already) {\n      reminders.push({ task_id: t.id, due_at: now.toISOString(), reminded_at: now.toISOString(), _task_name: t.name, _machine_id: t.machine_id });\n    }\n  }\n\n  // 2. ¿Logs recordados, sin confirmar, vencido el plazo de escalamiento?\n  for (const l of tLogs) {\n    if (l.reminded_at && !l.confirmed_at && !l.escalated) {\n      const hours = (now - new Date(l.reminded_at)) / 36e5;\n      if (hours >= (t.escalation_hours || 4)) {\n        escalations.push({ log_id: l.id, task_name: t.name, hours: Math.round(hours) });\n      }\n    }\n  }\n}\n\nreturn [{ json: { reminders, escalations } }];"
      },
      "id": "b4000000-0000-4000-8000-000000000004",
      "name": "Calcular Pendientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.first().json.reminders.map(r => ({ json: r }));"
      },
      "id": "b4000000-0000-4000-8000-000000000005",
      "name": "Split Recordatorios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -120
      ]
