      "id": "b4000000-0000-4000-8000-000000000002",
      "name": "Get Tareas Activas",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "afViDlP7RXmh3xeK",
          "name": "IMPCDMX Supabase (imprenta-cdmx)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
