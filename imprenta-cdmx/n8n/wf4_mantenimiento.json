        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "b4000000-0000-4000-8000-000000000001",
      "name": "Cada Hora",
      "type": "n8n-nodes-base.scheduleTrigger",
