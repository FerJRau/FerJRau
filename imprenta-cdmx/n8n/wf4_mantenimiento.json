              "fieldId": "task_id",
              "fieldValue": "={{ $json.task_id }}"
            },
            {
              "fieldId": "due_at",
              "fieldValue": "={{ $json.due_at }}"
            },
            {
              "fieldId": "reminded_at",
              "fieldValue": "={{ $json.reminded_at }}"
            }
          ]
        }
      },
